{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "preserveSymlinks": true,
    "paths": {
      "@mofur/*": [
        "../mofur/src/*"
      ]
    }
  },
  "include": [
    "./src",
    "../mofur/*"
  ],
  "exclude": [
    "../mofur/src/ax-react",
    "../mofur/src/mo-react"
  ]
}